# Web HMI Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
APP_ENV=development

# PLC Operation Mode: 'simulation' or 'real'
PLC_MODE=simulation

# Real PLC Connection Settings (Modbus TCP)
PLC_PROTOCOL=modbus_tcp
PLC_HOST=192.168.1.20
PLC_PORT=502
PLC_UNIT_ID=1
PLC_POLL_INTERVAL_MS=250

# SAFETY INTERLOCK: Set to true only when physical commissioning is verified.
# When false, real PLC writes are blocked, only reads are allowed.
ENABLE_REAL_PLC_WRITES=false

# Industrial Command Timeouts
COMMAND_ACK_TIMEOUT_MS=3000
COMMAND_EXECUTION_TIMEOUT_MS=15000

# Storage
DATABASE_PATH=./data/hmi.db

# Authentication (Local Operator / Admin)
AUTH_ENABLED=false
ADMIN_DEFAULT_PASSWORD=admin123
OPERATOR_DEFAULT_PASSWORD=operator123

# Simulation & Logging
LOG_LEVEL=info
SIMULATION_SPEED=1
